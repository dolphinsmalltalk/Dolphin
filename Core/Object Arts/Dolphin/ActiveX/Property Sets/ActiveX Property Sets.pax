!OS.COM.PropsysLibrary methodsFor!

clearPropVariantArray: rgPropVar cVars: cVars
	"Frees the memory and references used by an array of PROPVARIANT structures stored in an array.

	void ClearPropVariantArray(
		_Inout_updates_(cVars) PROPVARIANT *rgPropVar, 
		_In_ UINT cVars)
	);"

	<stdcall: void ClearPropVariantArray PROPVARIANT* uint32>
	^self invalidCall: _failureCode!

initPropVariantFromBooleanVector: prgf cElems: cElems ppropvar: aPROPVARIANT
	"Initializes a PROPVARIANT structure using the contents of a buffer.

	HRESULT InitPropVariantFromBooleanVector(
		[in]  const BOOL *prgf,
