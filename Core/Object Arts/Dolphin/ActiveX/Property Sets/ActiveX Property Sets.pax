initPropVariantFromString: aString ppropvar: aPROPVARIANT
	"Initializes a PROPVARIANT structure based on a specified string.

	HRESULT InitPropVariantFromString(
		[in]  PCWSTR      psz,
		[out] PROPVARIANT *ppropvar
	);"

	"Implemented inline in the propvarutil.h header file."

	aPROPVARIANT bytes
		uintPtrAtOffset: PROPVARIANT._OffsetOf_pwszVal
			put: aString asUtf16String copyToCOMTaskMemory detach;
		uintPtrAtOffset: _OffsetOf_vt put: VT_LPWSTR.
	^S_OK!

