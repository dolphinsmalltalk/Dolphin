!OS.COM.OLELibrary methodsFor!

freePropVariantArray: cVariants rgvars: rgvars
	"
		HRESULT FreePropVariantArray(
			_In_ ULONG cVariants,
			_Inout_updates_(cVariants) PROPVARIANT* rgvars
		);
	"

	<stdcall: hresult FreePropVariantArray uint32 PROPVARIANT*>
	^self invalidCall: _failureCode!

propVariantClear: pvar
	"The PropVariantClear function frees all elements that can be freed in a given PROPVARIANT structure. For complex elements with known element pointers, the underlying elements are freed prior to freeing the containing element.

		HRESULT PropVariantClear(_Inout_ PROPVARIANT* pvar)
	"

	<stdcall: int32 PropVariantClear PROPVARIANT*>
	^self invalidCall: _failureCode!

propVariantCopy: pvargDesc pvarSrc: pvargSrc
	"Create a copy of the <VARIANT>, pvargSrc, in the <VARIANT>, pvargDest.

		HRESULT PropVariantCopy(
			[out] PROPVARIANT* pvarDest,
			[in] const PROPVARIANT* pvarSrc );
	"

	<stdcall: hresult PropVariantCopy PROPVARIANT* PROPVARIANT*>
	^self invalidCall: _failureCode!

propVariantInit: pvar
	"The PropVariantClear function frees all elements that can be freed in a given PROPVARIANT structure. For complex elements with known element pointers, the underlying elements are freed prior to freeing the containing element.

		void PropVariantInit(_out_ PROPVARIANT* pvar)
	"

	"Implemented as a macro in a header file, so no export from the DLL to call"
	Kernel32 zeroMemory: pvar length:  PROPVARIANT._PROPVARIANT_Size!

stgCreatePropSetStg: pStorage dwReserved: dwReserved ppPropSetStg: ppPropSetStg
	"Invoke the StgCreatePropSetStg() function of the module wrapped by the receiver.
	Helpstring: Creates a property set storage object from a specified storage object

		HRESULT __stdcall StgCreatePropSetStg(
			[in]IStorage* pStorage,
			[in]DWORD dwReserved,
			[out, retval]IPropertySetStorage** ppPropSetStg);"

	<stdcall: hresult StgCreatePropSetStg IStorage* uint32 IPropertySetStorage**>
	^self invalidCall: _failureCode!

stgOpenPropStg: pUnk fmtid: fmtid grfFlags: grfFlags dwReserved: dwReserved ppPropStg: ppPropStg
	"Invoke the StgOpenPropStg() function of the module wrapped by the receiver.
	Helpstring: Opens a specified property set in a specified storage or stream object

		HRESULT __stdcall StgOpenPropStg(
			[in]IUnknown* pUnk,
			[in]GUID* fmtid,
			[in]DWORD grfFlags,
			[in]DWORD dwReserved,
			[out, retval]IPropertyStorage** ppPropStg);"

	<stdcall: hresult StgOpenPropStg IUnknown* guid* uint32 uint32 IPropertyStorage**>
	^self invalidCall: _failureCode! !

