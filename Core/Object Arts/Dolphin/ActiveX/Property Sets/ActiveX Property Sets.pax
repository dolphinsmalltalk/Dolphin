!OS.COM.VARIANT methodsFor!

filetimeVector
	"Private - Answer a <FILETIMEArray> representation of the array of DATE values in the receiver, assumed to contain a SAFEARRAY of VT_DATE."

	"Note the API asymmetry: A Propsys DLL function exists to initialize a VARIANT from FILETIME[], but not to access the array. Consequently we need to access the SAFEARRAY and convert it."

	^self getVector!

filetimeVector: aFILETIMEArray
	"We don't use Propsys.InitVariantFromFileTimeArray because it has bugs, e.g. doesn't handle FILETIME(0), and also truncates unnecessarily."

	self array: (SAFEARRAY withAll: aFILETIMEArray elementClass: DATE)!

initializeFromPropVariant: aPROPVARIANT
	"Private - Narrowing conversion PROPVARIANT -> VARIANT"

	Propsys propVariantToVariant: aPROPVARIANT pVar: self.
	"Workaround bug that PropVariantToVariant does not adjust for conversion from UTC FILETIME to local time DATE."
	aPROPVARIANT vt == VT_FILETIME
		ifTrue: 
			[bytes doubleAtOffset: _OffsetOf_date
				put: (bytes doubleAtOffset: _OffsetOf_date)
						+ (Locale timeZoneInformation offsetSeconds / Duration.SecondsPerDay)]!

storage
	"Private - Answer the <IStorage> value from the receiver.
	Assumes the receiver is of type VT_UNKNOWN/VT_DISPATCH but the stored object implements IStorage."

	| unk |
	unk := self unknown.
	^self isByRef ifTrue: [unk ifFalse: [unk queryInterface: IStorage]]!

storage: anIStorage
	"Private - Initialize the receiver to be a VT_UNKNOWN containing the <IUnknown> of the interface pointer argument."

	self unknown: anIStorage!

stream
	"Private - Answer the <IStream> value from the receiver.
	Assumes the receiver is of type VT_UNKNOWN/VT_DISPATCH but the stored object implements IStream."

	| unk |
	unk := self unknown.
	^self isByRef ifTrue: [unk ifFalse: [unk queryInterface: IStream]]!

stream: anIStream
	"Private - Initialize the receiver to be a VT_UNKNOWN containing the <IUnknown> of the interface pointer argument."

	self unknown: anIStream! !

