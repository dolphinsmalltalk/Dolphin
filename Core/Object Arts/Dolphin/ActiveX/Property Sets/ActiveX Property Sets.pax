!OS.COM.OleVariant methodsFor!

filetimeVector
	^self subclassResponsibility!

filetimeVector: aFILETIMEArray
	self subclassResponsibility!

hresultVector
	"Private - Answer an <HRESULTArray> containing the signed 32-bit integer error code values held by the receiver, assumed to be a VT_VECTOR|VT_ERROR or VT_ARRAY|VT_RECORD of HRESULT."

	^self getVector!

storage
	"Private - Answer the <IStorage> value from the receiver."

	^self subclassResponsibility!

storage: anIStorage
	"Private - Initialize the receiver to hold the <IStorage> interface pointer argument."

	self subclassResponsibility!

stored_object
	^Error notYetImplemented!

stored_object: newValue
	^Error notYetImplemented!

stream
	"Private - Answer the <IStream> value from the receiver."

	^self subclassResponsibility!

stream: anIStream
	"Private - Initialize the receiver to hold the <IStream> interface pointer argument."

	self subclassResponsibility!

streamed_object
	^Error notYetImplemented!

streamed_object: newValue
	^Error notYetImplemented!

versioned_stream
	^Error notYetImplemented!

versioned_stream: newValue
