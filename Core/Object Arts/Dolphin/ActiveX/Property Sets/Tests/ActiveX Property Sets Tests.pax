package setPrerequisites: #(
	'..\..\Automation\ActiveX Automation'
	'..\..\Automation\Tests\ActiveX Automation Tests'
	'..\ActiveX Property Sets'
	'..\..\..\Base\Dolphin'
	'..\..\..\Base\Tests\Dolphin Base Tests'
