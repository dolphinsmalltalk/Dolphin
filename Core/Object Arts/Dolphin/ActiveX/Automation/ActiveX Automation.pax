registerTypeLib: anITypeLib fullPath: aString
	AdvApi32 isRunningElevated
		ifTrue: 
			["Register machine wide if admin privileges available"
			self
				registerTypeLib: anITypeLib
				wszFullPath: aString
				wszHelpDir: nil]
		ifFalse: 
			["Register for the current user only"
			self
				registerTypeLibForUser: anITypeLib
				szFullPath: aString
				szHelpDir: nil]!

