!Core.Locale methodsFor!

defaultVarStrApiFlags
	^0!

displayCY: aCY flags: anInteger on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <CY> argument that a user in this <Locale> might expect to see."

	self subclassResponsibility!

displayCY: aCY on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <CY> argument that a user in this <Locale> might expect to see."

	self displayCY: aCY flags: self defaultVarStrApiFlags on: aWriteStream!

displayDATE: aDATE flags: anInteger on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <DATE> argument that a user in this <Locale> might expect to see."

	self subclassResponsibility!

displayDATE: aDATE on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <DATE> argument that a user in this <Locale> might expect to see."

	self
		displayDATE: aDATE
		flags: self defaultVarStrApiFlags
		on: aWriteStream!

displayDECIMAL: aDECIMAL flags: anInteger on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <DECIMAL>, aDecimal, that a user in this <Locale> might expect to see."

	self subclassResponsibility!

displayDECIMAL: aDECIMAL on: anInteger
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <DECIMAL>, aDecimal, that a user in this <Locale> might expect to see."

	self
		displayDECIMAL: aDECIMAL
		flags: self defaultVarStrApiFlags
		on: anInteger!

parseDATE: aString
	"Parse a <DATE> from the <String> argument, which is assumed to represent the printed representation of a variant date/time in the format used in this locale."

	^self parseDATE: aString flags: self defaultVarStrApiFlags!

parseDATE: aString flags: anInteger
	"Parse a <DATE> from the <String> argument, which is assumed to represent the printed representation of a variant date/time in the format used in this locale. The <integer> 2nd argument specifies flags accepted by the [VarDateFromStr() API](https://learn.microsoft.com/en-us/windows/win32/api/oleauto/nf-oleauto-vardatefromstr)."

	<namespace: OS.COM>
	| answer |
	answer := DATE new.
	OleAut32
		varDateFromStr: aString
		lcid: self asParameter
		dwFlags: anInteger
		pdateOut: answer.
	^answer!

variantBool: aBoolean
	^self subclassResponsibility! !

