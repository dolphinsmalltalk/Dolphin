!Core.GUID methodsFor!

getField: aString ifAbsent: aNiladicValuable
	"Answer the value of the field of the receiver named by the <String> 1st argument, or if there is no such field then the result of evaluating the <niladicValuable> 2nd argument."

	^(self class fieldAccessors lookup: aString)
		ifNil: [aNiladicValuable value]
		ifNotNil: [:accessor | accessor value: self yourAddress asExternalAddress]!

recordInfo
	"Answer an <IRecordInfo> describing the receiver's structure class."

	^self class recordInfo! !

