!Kernel.SmalltalkLocale methodsFor!

displayCY: aCY flags: anInteger on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <CY> argument that a user in this <Locale> might expect to see."

	aCY value displayOn: aWriteStream!

displayDATE: aDATE flags: anInteger on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <DATE> argument that a user in this locale might expect to see.
	Since this is the Smalltalk locale, we convert to a DateAndTime and display that. This avoids the vagaries of the VarBstrFromDate conversion such as omitting the time if there is no fractional part, or omitting the date (!!) if there is no integer part."

	aDATE value displayOn: aWriteStream!

displayDECIMAL: aDECIMAL flags: anInteger on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <DECIMAL>, aDecimal, that a user in this <Locale> might expect to see."

	aDECIMAL value displayOn: aWriteStream!

variantBool: aBoolean
	^aBoolean class name! !

!Kernel.SmalltalkLocale categoriesForMethods!
displayCY:flags:on:!displaying!public! !
displayDATE:flags:on:!displaying!public! !
displayDECIMAL:flags:on:!displaying!public! !
variantBool:!constants!public! !
!

!OS.AbstractWindowsLocale methodsFor!

boolFormat
	"Answer an <Array> of two <String>s, being the representations for false and true in this Locale."

	^{self variantBool: false. self variantBool: true}!

displayCY: aCY flags: anInteger on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <CY> argument that a user in this <Locale> might expect to see."

	<namespace: OS.COM>
	| bstr |
	bstr := BSTR new.
	OleAut32
		varBstrFromCy: aCY
		lcid: self lcid
		dwFlags: anInteger
		pbstrOut: bstr.
	bstr
		displayOn: aWriteStream;
		free!

displayDATE: aDATE flags: anInteger on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <DATE> argument that a user in this <Locale> might expect to see."

	<namespace: OS.COM>
	| bstr |
	bstr := BSTR new.
	OleAut32
		varBstrFromDate: aDATE
		lcid: self lcid
		dwFlags: anInteger
		pbstrOut: bstr.
	bstr
		displayOn: aWriteStream;
		free!

displayDECIMAL: aDECIMAL flags: anInteger on: aWriteStream
	"Append to the <puttableStream> argument, aWriteStream, a <String> whose characters are a representation of the <DECIMAL>, aDecimal, that a user in this <Locale> might expect to see."

	<namespace: OS.COM>
	| bstr |
	bstr := BSTR new.
	OleAut32
		varBstrFromDec: aDECIMAL
		lcid: self lcid
		dwFlags: anInteger
		pbstrOut: bstr.
	bstr
		displayOn: aWriteStream;
		free!

getVariantBoolString: anInteger
	<namespace: OS.COM>
	| bstr str |
	bstr := BSTR new.
	OleAut32
		varBstrFromBool: anInteger
		lcid: self lcid
		dwFlags: OLEAutLibrary.VARIANT_LOCALBOOL
		pbstrOut: bstr.
	str := bstr asUtf8String.
	bstr free.
	^str!

variantBool: aBoolean
	^info at: aBoolean class name
		ifAbsentPutClean: 
			[self getVariantBoolString: (aBoolean
						ifTrue: [OS.COM.OLEAutLibrary.VARIANT_TRUE]
						ifFalse: [OS.COM.OLEAutLibrary.VARIANT_FALSE])]! !

