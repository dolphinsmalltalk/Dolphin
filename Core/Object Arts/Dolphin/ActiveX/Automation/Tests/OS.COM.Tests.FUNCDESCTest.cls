verifyStbConversion: aFUNCDESC
	self assert: aFUNCDESC class identicalTo: FUNCDESC.
	self assert: aFUNCDESC owner isKindOf: TKindInterfaceAnalyzer.
	self assert: aFUNCDESC displayString equals: 'Next(plNext)'.
	self assert: aFUNCDESC outputIndices equals: #(1).
	self assert: aFUNCDESC retvalIndex equals: 1.
	self assert: (String streamContents: [:strm | aFUNCDESC methodName printSignatureOn: strm])
		equals: 'Next: plNext'.
	self assert: aFUNCDESC analyzer generationFlags equals: 0.
	self assert: aFUNCDESC analyzer binding equals: #{COM.Examples.IRandomStream} binding.
	self deny: aFUNCDESC analyzer isSource.
	self assert: aFUNCDESC analyzer protocol equals: (MethodProtocol name: 'RANDOMLib.IRandomStream').
	self assert: aFUNCDESC analyzer guid
		equals: (GUID fromString: '{0E2CEA3B-E6C4-11D2-833B-0020AFAB8EFE}')! !

