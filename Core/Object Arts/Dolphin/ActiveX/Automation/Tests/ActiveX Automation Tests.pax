"Loose Methods"!

!Core.Tests.GUIDTest methodsFor!

testRecordInfo
	"Tests the implementation of IRecordInfo on GUID"

	<namespace: OS.COM.Tests>
	| subject recordInfo data recordInfo2 pGuid |
	subject := self subjectClass fromString: '{d04f83eb-af94-4b01-b93d-bda6c89c6e41}'.
	recordInfo := subject recordInfo.
	self assert: recordInfo guid equals: self subjectClass guid.
	self assert: recordInfo name equals: self subjectClass name.
	self assert: recordInfo getFieldNames equals: #('Data1' 'Data2' 'Data3' 'Data4').
	data := recordInfo
				getField: 'Data1'
				from: subject
				ifAbsent: [self fail: 'Missing Data1'].
	self assert: data equals: 16rD04F83EB.
	data := recordInfo
				getField: 'Data2'
				from: subject
				ifAbsent: [self fail: 'Missing Data1'].
	self assert: data equals: 16rAF94.
	data := recordInfo
				getField: 'Data3'
				from: subject
				ifAbsent: [self fail: 'Missing Data1'].
	self assert: data equals: 16r4B01.
	data := recordInfo
				getField: 'Data4'
				from: subject
				ifAbsent: [self fail: 'Missing Data1'].
	self assert: data value value equals: #[16rB9 16r3D 16rBD 16rA6 16rC8 16r9C 16r6E 16r41].
	self
		should: 
			[recordInfo
				setField: 'Data1'
				value: 1234
				into: subject
				ifAbsent: [self fail: 'Data1 missing']]
		raise: HRESULTError
		matching: [:ex | ex statusCode = 36].
	self assertIsNil: recordInfo typeInfo.
	recordInfo2 := GUID recordInfo.
	self assert: (recordInfo IsMatchingType: recordInfo2).
	self assert: (recordInfo2 IsMatchingType: recordInfo).
	recordInfo2 free.
	recordInfo2 := RECTL recordInfo.
	self deny: (recordInfo IsMatchingType: recordInfo2).
	self deny: (recordInfo2 IsMatchingType: recordInfo).
	recordInfo2 free.
	pGuid := recordInfo RecordCreate.
	self assert: (TaskMemory didAlloc: pGuid).
	self assert: (pGuid copyFrom: 1 to: 16) equals: (ByteArray new: 16).
	self assert: (recordInfo RecordCopy: subject pvNew: pGuid) equals: S_OK.
	self assert: (pGuid copyFrom: 1 to: 16) equals: subject asByteArray.
	self assert: (recordInfo RecordDestroy: pGuid) equals: S_OK.
	pGuid := TaskMemory new.
	self assert: (recordInfo RecordCreateCopy: subject ppvDest: pGuid) equals: S_OK.
	self assert: (TaskMemory didAlloc: pGuid).
	self assert: (pGuid copyFrom: 1 to: 16) equals: subject asByteArray.
	self assert: (recordInfo RecordDestroy: pGuid detach) equals: S_OK.
	recordInfo free! !

!Core.Tests.GUIDTest categoriesForMethods!
testRecordInfo!public!unit tests! !
!

!External.Tests.AddressTest methodsFor!

testBSTRFromAddress
	| empty |
	self stringFromAddressTestClass: OS.COM.BSTR.
	"By convention, a null BSTR is equivalent to the empty string"
	empty := OS.COM.BSTR new.
	self assert: (OS.COM.BSTR fromAddress: nil) equals: empty.
	self assert: (OS.COM.BSTR fromAddress: 0) equals: empty! !

!External.Tests.AddressTest categoriesForMethods!
testBSTRFromAddress!public!unit tests! !
!

!External.Tests.DOUBLEArrayTest methodsFor!

testAsVariant
	| var subject values |
	values := #(-1.5 0 1 1.25).
	subject := DOUBLEArray withAll: values.
	var := subject asVariant.
	self assert: var isArray.
	self assert: var value asArray equals: values! !

!External.Tests.DOUBLEArrayTest categoriesForMethods!
testAsVariant!public!unit tests! !
!

