removeExtension:!filename manipulation!public! !
removePathDelimiter:!filename manipulation!public! !
replacePath:with:!filename manipulation!public! !
shortPathOf:!filename manipulation!public! !
splitDriveFrom:!filename manipulation!public! !
splitExtensionFrom:!filename manipulation!public! !
splitFilenameFrom:!filename manipulation!public! !
splitPath:!filename manipulation!public! !
splitPathFrom:!filename manipulation!public! !
splitStemFrom:!filename manipulation!public! !
temporaryFilename!helpers!public! !
temporaryFilenameWithPrefix:!helpers!public! !
tempPath!enquiries!public! !
workingDirectory!enquiries!public! !
!

!Core.FileLocator methodsFor!

localFileSpecFor: aString
	#deprecated.
	^(self resolve: aString) path!

relativePathTo: aString
	#deprecated.
	^self abstract: aString! !

!Core.FileLocator categoriesForMethods!
localFileSpecFor:!mapping!public! !
relativePathTo:!mapping!public! !
!

!Core.FileLocator class methodsFor!

imageRelative: aFilenameString
	#deprecated.
	^self imageRelative localFileSpecFor: aFilenameString
!

installRelative: aFilenameString
	#deprecated.
	^self installRelative localFileSpecFor: aFilenameString
! !

!Core.FileLocator class categoriesForMethods!
imageRelative:!instance creation!public! !
installRelative:!instance creation!public! !
!

"End of package definition"!

