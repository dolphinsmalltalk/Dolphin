buildTestFilenameOfLength: anInteger
	| maxPath |
	maxPath := String writeStream.
	0 to: anInteger - 5 do: [:i | maxPath nextPut: ('abcdefgh' at: i % 8 + 1)].
	maxPath := maxPath contents.
	maxPath := maxPath , '.txt'.
	self assert: maxPath size equals: anInteger.
	^maxPath!

