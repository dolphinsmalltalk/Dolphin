test64BitSeek
	"Tests #755"

	| dist pointer |
	tempFile := File temporary.
	0 to: 31
		do: 
			[:i |
			dist := 2 raisedToInteger: i.
			pointer := tempFile seek: dist sense: FILE_BEGIN.
			self assert: pointer equals: dist.
			pointer := tempFile seek: -1 sense: FILE_CURRENT.
			self assert: pointer equals: dist - 1.
			pointer := tempFile seek: 1 sense: FILE_CURRENT.
			self assert: pointer equals: dist.
			pointer := tempFile seek: 1 sense: FILE_CURRENT.
			self assert: pointer equals: dist + 1.
			pointer := tempFile seek: dist negated sense: FILE_CURRENT.
			self assert: pointer equals: 1].
	32 to: 62
		do: 
			[:i |
			dist := 2 raisedToInteger: i.
			pointer := tempFile seek: dist sense: FILE_BEGIN.
			self assert: pointer equals: dist.
			pointer := tempFile seek: -1 sense: FILE_CURRENT.
			self assert: pointer equals: dist - 1.
			pointer := tempFile seek: 1 sense: FILE_CURRENT.
			self assert: pointer equals: dist.
			pointer := tempFile seek: 1 sense: FILE_CURRENT.
			self assert: pointer equals: dist + 1.
			pointer := tempFile seek: dist negated sense: FILE_CURRENT.
			self assert: pointer equals: 1].
	pointer := tempFile seek: -1 sense: FILE_CURRENT.
	self assert: pointer identicalTo: 0.
	"As the 64-bit offset is signed, the maximum seek offset is 2^63-1"
	self should: [tempFile seek: 2 ** 63 sense: FILE_BEGIN] raise: Error.
	"Test the condition where the low-word of the return is 16rFFFFFFFF, so GetLastError() is needed to disambiguate from an error condition."
	dist := 2 ** 32 - 1.
	pointer := tempFile seek: dist sense: FILE_BEGIN.
	"Now test maximum seek distance"
	dist := 2 ** 63 - 1.
	pointer := tempFile seek: dist sense: FILE_BEGIN.
	self assert: pointer equals: dist.
	"Although not really a negative seek, it would cause a 64-bit signed file pointer to go negative"
	self
		should: [tempFile seek: 1 sense: FILE_CURRENT]
		raise: FileException
		matching: [:ex | ex statusCode = 131	"ERROR_NEGATIVE_SEEK"].
	pointer := tempFile seek: dist negated sense: FILE_CURRENT.
	self assert: pointer equals: 0!

testAtEnd
	tempFile := File temporary.
	self assert: tempFile size equals: 0.
	self assert: tempFile position equals: 0.
	self assert: tempFile atEnd.
	tempFile write: 'a'.
	self assert: tempFile size equals: 1.
	self assert: tempFile position equals: 1.
	self assert: tempFile atEnd.
	tempFile write: 'bc'.
	self assert: tempFile size equals: 3.
	self assert: tempFile position equals: 3.
	self assert: tempFile atEnd.
	tempFile position: 0.
	self assert: tempFile size equals: 3.
	self assert: tempFile position equals: 0.
	self deny: tempFile atEnd.
	tempFile write: 'A'.
	self assert: tempFile size equals: 3.
	self assert: tempFile position equals: 1.
	self deny: tempFile atEnd.
	tempFile write: 'BC'.
	self assert: tempFile size equals: 3.
	self assert: tempFile position equals: 3.
	self assert: tempFile atEnd.
	tempFile write: 'D'.
	self assert: tempFile size equals: 4.
	self assert: tempFile position equals: 4.
	self assert: tempFile atEnd.
!

testCreateDirectoryPath
	| tempDir |
	"It is not an error to attempt to create directory paths that already exist"
	#('c:' 'c:\' 'c:\windows' 'c:\windows\' 'c:\windows\system32' 'c:\windows\system32\')
		do: [:each | self deny: (File createDirectoryPath: each)].
	"We want the operation to fail if the path refers to an existing file, as obviously we can't use this as a directory."
	self
		should: [File createDirectoryPath: VM fileName]
		raise: OS.Win32Error
		matching: [:ex | ex statusCode == OS.Win32Errors.ERROR_FILE_EXISTS].
	tempDir := File createTemporaryDirectory asUtf16String.
	
	[| path |
	path := Filename composePath: tempDir subPath: 'one'.
	File createDirectoryPath: path.
	self assert: (File isDirectory: path).
	path := Filename composePath: tempDir subPath: 'one\two\three'.
	File createDirectoryPath: path.
	self assert: (File isDirectory: path).
	path := Filename composePath: tempDir subPath: (String new: 248 - tempDir size - 1 withAll: $a).
	self assert: path size equals: 248.
	self deny: (path beginsWith: '\\?\').
	File createDirectoryPath: path.
	self assert: (File isDirectory: path).
	path := Filename composePath: tempDir subPath: (String new: 248 - tempDir size withAll: $b).
	self assert: path size equals: 249.
	self deny: (path beginsWith: '\\?\').
	File createDirectoryPath: path.
	self assert: (File isDirectory: path).
	path := Filename composePath: tempDir subPath: (String new: 255 - tempDir size - 1 withAll: $b).
	self assert: path size equals: 255.
	self deny: (path beginsWith: '\\?\').
	File createDirectoryPath: path.
	self assert: (File isDirectory: path).
	path := Filename composePath: tempDir subPath: (String new: MAX_PATH - tempDir size - 2 withAll: $c).
	self assert: path size equals: MAX_PATH - 1.
	self deny: (path beginsWith: '\\?\').
	File createDirectoryPath: path.
	self assert: (File isDirectory: path).
	path := Filename composePath: tempDir subPath: 'long\' , (String new: 250 withAll: $£).
	self assert: (path beginsWith: self longPathPrefix).
	File createDirectoryPath: path.
	self assert: (File isDirectory: path)]
			ensure: [File deleteDirectory: tempDir]!

testCreateFileWithLongName
	<skipUnless: #longFilenamesEnabled>
	| tempDir tmpFile file |
	tempDir := File createTemporaryDirectory.
	tmpFile := tempDir , '\' , (self buildTestFilenameOfLength: MAX_PATH - 5).
	self assert: tmpFile size > MAX_PATH.
	file := File open: tmpFile mode: #create.
	self assert: file pathName equals: '\\?\', tmpFile.
	file close!

