| package |
package := Package name: 'Common Controls Library'.
package paxVersion: 2.1;
	basicComment: ''.


package setClassNames: #(
	#{OS.CommCtrlLibrary}
).

package setPrerequisites: #(
	'..\..\..\Base\Dolphin'
).

package!

