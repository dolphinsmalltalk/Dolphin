"Loose Methods"!

!Core.File methodsFor!

title
	"Answer the receiver's 'title' (i.e. the display name)."

	^Path titleOf: self name! !

!Core.File categoriesForMethods!
title!accessing!public! !
!

!Core.File class methodsFor!

titleOf: aString
	#deprecated.
	^Path titleOf: aString! !

!Core.File class categoriesForMethods!
titleOf:!filename manipulation!public! !
!

!Core.Path methodsFor!

title
	"Answer the 'title' (i.e. the display name) of a file with the specified path name.
	The file title may or may not include the extension, depending on the user's configuration."

	| buf len utf16 |
	utf16 := path asUtf16String.
	(len := ComDlg32
				getFileTitle: utf16
				lpszTitle: nil
				cbBuf: 0) < 0
		ifTrue: [ComDlg32 systemError: 123].
	buf := Utf16String newFixed: len - 1.
	(ComDlg32
		getFileTitle: utf16
		lpszTitle: buf
		cbBuf: len) < 0
		ifTrue: [ComDlg32 systemError: 123].
	^buf! !

!Core.Path categoriesForMethods!
title!accessing!public! !
!

!Core.Path class methodsFor!

titleOf: aString
	"Answer the 'title' (i.e. the display name) of a file with the specified path name.
	The file title may or may not include the extension, depending on the user's
	configuration."

	^aString asPath title! !

!Core.Path class categoriesForMethods!
titleOf:!legacy File api!public! !
!

"End of package definition"!

