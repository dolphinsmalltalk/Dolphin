| package |
package := Package name: 'Dolphin ControlViews Base'.
package paxVersion: 2.1;
	basicComment: 'Dolphin 🐬 Smalltalk MVP Base Control Views
Copyright © Object Arts Ltd. 1997-2023.  Portions Copyright (c) CGI Group (Europe) Ltd. 1997.'.


package setClassNames: #(
	#{UI.CommonControlFailure}
	#{UI.ControlView}
	#{UI.StaticControlView}
	#{UI.StaticView}
	#{UI.ValueConvertingControlView}
).

package setPrerequisites: #(
	'..\..\System\Win32\CommCtrl\Common Controls Library'
	'..\..\Base\Dolphin'
	'..\Graphics\Dolphin GDI Graphics'
	'Dolphin MVP Base'
	'..\Type Converters\Dolphin Type Converters'
).

package!

"Class Definitions"!

Core.Error
	subclass: #'UI.CommonControlFailure'
	instanceVariableNames: ''
	classVariableNames: ''
	imports: #()
	classInstanceVariableNames: ''
	classConstants: {}!

UI.View
	subclass: #'UI.ControlView'
	instanceVariableNames: 'forecolor oldWndProc'
	classVariableNames: ''
	imports: #(#{OS.CommCtrlLibrary private})
	classInstanceVariableNames: ''
	classConstants: { 'BN_CLICKED' -> 16r0 }!

UI.ControlView
	subclass: #'UI.ValueConvertingControlView'
	instanceVariableNames: 'typeconverter'
	classVariableNames: ''
	imports: #()
	classInstanceVariableNames: ''
	classConstants: {}!

UI.ValueConvertingControlView
	subclass: #'UI.StaticView'
	instanceVariableNames: 'unused'
	classVariableNames: ''
	imports: #()
	classInstanceVariableNames: ''
	classConstants: {
			'SS_CENTER' -> 16r1.
			'SS_CENTERIMAGE' -> 16r200.
			'SS_ENHMETAFILE' -> 16rF.
			'SS_LEFT' -> 16r0.
			'SS_LEFTNOWORDWRAP' -> 16rC.
			'SS_NOPREFIX' -> 16r80.
			'SS_NOTIFY' -> 16r100.
			'SS_OWNERDRAW' -> 16rD.
			'SS_REALSIZEIMAGE' -> 16r800.
			'SS_RIGHT' -> 16r2.
			'SS_RIGHTJUST' -> 16r400.
			'SS_SIMPLE' -> 16rB.
			'SS_SUNKEN' -> 16r1000.
			'SS_TYPEMASK' -> 16r1F.
			'SS_USERITEM' -> 16rA
		}!

UI.StaticView
	subclass: #'UI.StaticControlView'
	instanceVariableNames: ''
	classVariableNames: ''
	imports: #()
	classInstanceVariableNames: ''
	classConstants: {}!

"End of package definition"!

