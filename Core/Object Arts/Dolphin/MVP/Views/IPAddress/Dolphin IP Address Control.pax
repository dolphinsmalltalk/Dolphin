| package |
package := Package name: 'Dolphin IP Address Control'.
package paxVersion: 2.1;
	basicComment: 'Dolphin Smalltalk IP Address Common Control.
Copyright (c) Object Arts Ltd 2004.

This package contains an MVP View wrapper, IPAddress, for the Windows IP Address common control.'.

package basicPackageVersion: '6.0'.


package setClassNames: #(
	#{OS.NMIPADDRESS}
	#{UI.IPAddressView}
).

package setMethodNames: #(
	#(#{UI.NumberPresenter class} #resource_IP_address_view)
).

package setPrerequisites: #(
	'..\..\..\System\Win32\CommCtrl\Common Controls Library'
	'..\..\..\Base\Dolphin'
	'..\..\Base\Dolphin Basic Geometry'
	'..\..\Base\Dolphin ControlViews Base'
	'..\..\Graphics\Dolphin GDI Graphics'
	'..\..\..\System\Filer\Dolphin Literal Filer (Old versions)'
	'..\..\Base\Dolphin MVP Base'
	'..\..\Presenters\Number\Dolphin Number Presenter'
	'..\..\..\System\Filer\Dolphin STx Filer Core'
	'..\..\Type Converters\Dolphin Type Converters'
	'..\..\Models\Value\Dolphin Value Models'
).

package!

"Class Definitions"!

OS.NMHDR
	subclass: #'OS.NMIPADDRESS'
	instanceVariableNames: ''
	classVariableNames: ''
	imports: #()
	classInstanceVariableNames: ''
	classConstants: {
			'_NMIPADDRESS_Size' -> 16r14.
			'_OffsetOf_iField' -> 16rC.
			'_OffsetOf_iValue' -> 16r10
		}!

UI.ValueConvertingControlView
	subclass: #'UI.IPAddressView'
	instanceVariableNames: ''
	classVariableNames: ''
	imports: #()
	classInstanceVariableNames: ''
	classConstants: {
			'ICC_INTERNET_CLASSES' -> 16r800.
			'IPM_CLEARADDRESS' -> 16r464.
			'IPM_GETADDRESS' -> 16r466.
			'IPM_ISBLANK' -> 16r469.
			'IPM_SETADDRESS' -> 16r465.
			'IPM_SETFOCUS' -> 16r468.
			'IPM_SETRANGE' -> 16r467.
			'IPN_FIELDCHANGED' -> -16r35C.
			'IPN_FIRST' -> -16r35C.
			'IpnMap' -> #(#ipnFieldChanged:)
		}!

