| package |
package := Package name: 'Console Application Kit'.
package paxVersion: 2.1;
	basicComment: 'Dolphin Smalltalk Console Application Kit
Copyright (c) Object Arts Ltd, 2001-2002.

Components for building and deploying console applications.
'.


package setClassNames: #(
	#{Kernel.ConsoleSessionManager}
).

package setMethodNames: #(
	#(#{Kernel.VMLibrary} #getStdioStream:)
).

package setPrerequisites: #(
	'..\Base\Dolphin'
).

package!

"Class Definitions"!

Core.SessionManager
	subclass: #'Kernel.ConsoleSessionManager'
	instanceVariableNames: ''
	classVariableNames: ''
	imports: #()
	classInstanceVariableNames: ''
	classConstants: {}!

"Loose Methods"!

!Kernel.VMLibrary methodsFor!

getStdioStream: anInteger
	"Private - Answer the handle of a CRT stdio standard output stream"

	<cdecl: handle GetStdioStream uint32>
	^self invalidCall: _failureCode! !

!Kernel.VMLibrary categoriesForMethods!
getStdioStream:!enquiries!private! !
!

"End of package definition"!

